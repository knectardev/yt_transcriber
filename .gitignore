.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
transcriptions/
*.wav
*.mp3
*.flac
*.mid
*.musicxml
*.xml
!tests/**/*.wav
!tests/**/*.mid
!tests/**/*.musicxml
# Score copies in the parse history are committed. Audio stays ignored.
!data/parses/**/*.mid
!data/parses/**/*.musicxml
!data/parses/**/*.xml
data/parses/events/.tmp-*/
# Fragment library: manifests and small score files are committed.
!data/fragments/**/*.mid
!data/fragments/**/*.musicxml
data/fragments/.tmp-*/
# Bach catalog: committed metadata under data/catalog/; local MIDI mirror is not.
catalog/
!data/catalog/
!data/catalog/**/*.json
# Performance reader partition (Vercel Root Directory). Git-tracked static deploy.
# Do not ignore reader/ or reader/catalog/*.json — that is the public projection.
!reader/
!reader/**
# Keep root build/dist ignored; reader/ is not those folders.
# Machine-local fragment index and generated fragment pages.
.local/
.cache/
data/thumbnails/
*.part
.streamlit/
# Local prompt / scratch notes — not project docs.
notes.txt

